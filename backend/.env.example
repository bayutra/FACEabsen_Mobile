# Hospital Face ID Attendance — Backend env example
# Copy to .env for local development: copy .env.example .env (Windows) / cp .env.example .env
PORT=3000
API_PREFIX=api/v1
NODE_ENV=development
# CORS tidak dibutuhkan oleh aplikasi mobile. Isi hanya bila ada integrasi
# browser/SIMRS yang memanggil API langsung dari origin lain.
# CORS_ORIGIN=https://simrs.example
# STEP 2 — database (PostgreSQL). Production wajib pakai secret manager, bukan file.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/face_absen?schema=public
# STEP 3 — auth (PRD S7/S8/S35). Production wajib pakai secret manager, bukan file.
JWT_ACCESS_SECRET=change-me-in-production-min-32-chars
JWT_ACCESS_TTL_SEC=900
REFRESH_TTL_DAYS=7
LOGIN_MAX_ATTEMPTS=5
LOCKOUT_MINUTES=15
# STEP 9 — face template encryption (AES-256-GCM, base64 of 32 random bytes).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=change-me-base64-32-bytes
# STEP 12 — attendance policy (PRD S21).
FACE_MATCH_THRESHOLD=0.5
LIVENESS_MAX_AGE_MIN=10
REQUEST_MAX_SKEW_MIN=5
# Hospital calendar zone (IANA) for work-date + shift windows. WIB default.
HOSPITAL_TZ=Asia/Jakarta
# STEP 13 — risk engine table + thresholds (PRD S23). Calibrate after pilot.
# GPS/geofence signals were removed; their weight folded into face + integrity.
RISK_W_FACE=45
RISK_W_LIVENESS=20
RISK_W_DEVICE=15
RISK_W_INTEGRITY=15
RISK_W_SIGNATURE=5
RISK_LOW_MIN=90
RISK_MEDIUM_MIN=70
RISK_MEDIUM_REVIEW=true
# STEP 21 — retention (days). Face templates of inactive staff past this age are purged.
RETENTION_SESSION_DAYS=30
RETENTION_FACE_INACTIVE_DAYS=90
# STEP 3+ (placeholder):
# REDIS_URL=redis://localhost:6379
# JWT_REFRESH_SECRET=change-me

# App version gate (mobile). Raise APP_MIN_VERSION when an old app build
# must be blocked from presensi until it updates.
APP_MIN_VERSION=1.0.0
APP_LATEST_VERSION=1.0.0
APP_UPDATE_MESSAGE=Versi aplikasi Anda sudah tidak didukung. Silakan perbarui aplikasi untuk melanjutkan presensi.

# STEP 22 — push notifications (FCM HTTP v1). Optional; leave unset to disable.
# Download the service-account JSON from Firebase Console → Project settings →
# Service accounts → Generate new private key, then either point the backend at
# the file (recommended) or paste its contents as base64/raw JSON:
FCM_SERVICE_ACCOUNT_PATH=secrets/firebase-service-account.json
# FCM_SERVICE_ACCOUNT_JSON=
# Split credentials are also supported instead of the JSON file:
# FCM_PROJECT_ID=face-absen
# FCM_CLIENT_EMAIL=firebase-adminsdk-xxxxx@face-absen.iam.gserviceaccount.com
# FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Set to false to keep credentials configured but temporarily stop delivery.
# FCM_ENABLED=true
