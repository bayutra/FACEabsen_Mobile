# Hospital Face ID Attendance — Backend env example
# Copy to .env for local development: copy .env.example .env (Windows) / cp .env.example .env
PORT=3000
API_PREFIX=api/v1
NODE_ENV=development
# CORS tidak dibutuhkan oleh aplikasi mobile. Isi hanya bila ada integrasi
# browser/SIMRS yang memanggil API langsung dari origin lain.
# CORS_ORIGIN=https://simrs.example
# STEP 2 — database (PostgreSQL). Production wajib pakai secret manager, bukan file.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/face_absen?schema=public
# STEP 3 — auth (PRD S7/S8/S35). Production wajib pakai secret manager, bukan file.
JWT_ACCESS_SECRET=change-me-in-production-min-32-chars
JWT_ACCESS_TTL_SEC=900
REFRESH_TTL_DAYS=7
LOGIN_MAX_ATTEMPTS=5
LOCKOUT_MINUTES=15
# STEP 9 — face template encryption (AES-256-GCM, base64 of 32 random bytes).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=change-me-base64-32-bytes
# STEP 12 — attendance policy (PRD S21).
FACE_MATCH_THRESHOLD=0.5
LIVENESS_MAX_AGE_MIN=10
REQUEST_MAX_SKEW_MIN=5
# Hospital calendar zone (IANA) for work-date + shift windows. WIB default.
HOSPITAL_TZ=Asia/Jakarta
# STEP 13 — risk engine table + thresholds (PRD S23). Calibrate after pilot.
# GPS/geofence signals were removed; their weight folded into face + integrity.
RISK_W_FACE=45
RISK_W_LIVENESS=20
RISK_W_DEVICE=15
RISK_W_INTEGRITY=15
RISK_W_SIGNATURE=5
RISK_LOW_MIN=90
RISK_MEDIUM_MIN=70
RISK_MEDIUM_REVIEW=true
# STEP 21 — retention (days). Face templates of inactive staff past this age are purged.
RETENTION_SESSION_DAYS=30
RETENTION_FACE_INACTIVE_DAYS=90
# STEP 3+ (placeholder):
# REDIS_URL=redis://localhost:6379
# JWT_REFRESH_SECRET=change-me
