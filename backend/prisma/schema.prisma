// Hospital Face ID Attendance — Database schema (STEP 2)
// Provider: PostgreSQL. Standard: snake_case tables/columns (@@map/@map),
// cuid() PKs (no DB extension needed), Restrict on history-bearing relations
// so attendance/device/audit history can never be cascade-deleted.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------- Enums (PRD §10, §20-§21, §30, §36-§37) ----------------

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

enum DeviceStatus {
  PENDING
  ACTIVE
  REVOKED
  LOST
  REPLACED
}

enum DeviceChangeStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum CheckInStatus {
  ON_TIME
  LATE
  VERY_LATE
}

enum CheckOutStatus {
  NORMAL_CHECKOUT
  EARLY_CHECKOUT
}

enum RiskCategory {
  LOW
  MEDIUM
  HIGH
}

enum CorrectionType {
  MISSED_CHECK_IN
  MISSED_CHECK_OUT
  WRONG_TIME
  TECHNICAL_ISSUE
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum LeaveType {
  CUTI
  SAKIT
  IZIN
  DINAS
  LAINNYA
}

// ---------------- Master: hospital & department ----------------

model Hospital {
  id                   String       @id @default(cuid())
  code                 String       @unique
  name                 String
  address              String?
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")
  departments          Department[]
  shifts               Shift[]
  handovers            Handover[]

  @@map("hospitals")
}

model Department {
  id         String     @id @default(cuid())
  hospitalId String     @map("hospital_id")
  hospital   Hospital   @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  name       String
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")
  employees  Employee[]
  handovers  Handover[]

  @@unique([hospitalId, name])
  @@index([hospitalId])
  @@map("departments")
}

// ---------------- Auth: users, roles, permissions (PRD §7-§8) ----------------

model User {
  id                  String                @id @default(cuid())
  email               String                @unique
  passwordHash        String                @map("password_hash") // Argon2id (STEP 3)
  failedLoginAttempts Int                   @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?             @map("locked_until")
  isActive            Boolean               @default(true) @map("is_active")
  totpSecret          String?               @map("totp_secret") // base32 TOTP secret, PENDING until totpEnabled
  totpEnabled         Boolean               @default(false) @map("totp_enabled")
  emailVerifiedAt     DateTime?             @map("email_verified_at")
  approvedAt          DateTime?             @map("approved_at")
  approvedById        String?               @map("approved_by_id")
  emailCodes          EmailVerificationCode[]
  createdAt           DateTime              @default(now()) @map("created_at")
  updatedAt           DateTime              @updatedAt @map("updated_at")
  employee            Employee?
  userRoles           UserRole[]
  sessions            Session[]
  recoveryCodes       TotpRecoveryCode[]
  auditLogs           AuditLog[]            @relation("AuditActor")
  revokedDevices      Device[]              @relation("DeviceRevoker")
  reviewedDevChanges  DeviceChangeRequest[] @relation("ChangeReviewer")
  reviewedCorrections CorrectionRequest[]   @relation("CorrectionReviewer")
  reviewedLeaves      LeaveRequest[]        @relation("LeaveReviewer")
  acknowledgedHandovers Handover[] @relation("HandoverAcknowledger")

  @@map("users")
}

// TOTP single-use recovery codes (STEP 2x). Plaintext is returned ONCE at
// enable time; only SHA-256 hashes are stored. Consumed codes get usedAt.
model TotpRecoveryCode {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String    @map("code_hash")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@unique([userId, codeHash])
  @@index([userId])
  @@map("totp_recovery_codes")
}

// Email verification codes (Phase 1, P0).
model EmailVerificationCode {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash   String    @map("code_hash")
  attempts   Int       @default(0)
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("email_verification_codes")
}

model Role {
  id              String           @id @default(cuid())
  name            String           @unique // EMPLOYEE | SUPERVISOR | ADMIN | SUPER_ADMIN
  description     String?
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@map("roles")
}

model Permission {
  id              String           @id @default(cuid())
  key             String           @unique // resource:action, e.g. attendance:approve:team
  description     String?
  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  assignedAt   DateTime   @default(now()) @map("assigned_at")

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId     String   @map("user_id")
  roleId     String   @map("role_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)
  assignedAt DateTime @default(now()) @map("assigned_at")

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

// ---------------- Employee (PRD §26) ----------------

model Employee {
  id            String                @id @default(cuid())
  userId        String?               @unique @map("user_id")
  user          User?                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  employeeNo    String                @unique @map("employee_no")
  name          String
  email         String                @unique
  phone         String?
  departmentId  String?               @map("department_id")
  department    Department?           @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  position      String?
  supervisorId  String?               @map("supervisor_id")
  supervisor    Employee?             @relation("Supervision", fields: [supervisorId], references: [id], onDelete: SetNull)
  subordinates  Employee[]            @relation("Supervision")
  status        EmployeeStatus        @default(ACTIVE)
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")
  faceTemplate   FaceTemplate?
  consents       Consent[]
  devices       Device[]
  deviceChanges DeviceChangeRequest[]
  schedules     EmployeeSchedule[]
  attendances   Attendance[]
  corrections   CorrectionRequest[]
  leaves        LeaveRequest[]
  handoversFrom Handover[] @relation("HandoverFrom")
  handoversTo   Handover[] @relation("HandoverTo")

  @@index([departmentId])
  @@index([supervisorId])
  @@index([status])
  @@map("employees")
}

// ---------------- Face template (PRD §12-§13, one active row per employee) ----------------

model FaceTemplate {
  id             String   @id @default(cuid())
  employeeId     String   @unique @map("employee_id")
  employee       Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  templateCipher Bytes    @map("template_cipher") // encrypted embedding (BYTEA), never exposed via API
  algorithm      String   @default("MobileFaceNet_v1")
  version        Int      @default(1)
  qualityScore   Float?   @map("quality_score")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("face_templates")
}

// ---------------- Device binding & replacement (PRD §9-§11) ----------------

model Device {
  id              String                @id @default(cuid())
  employeeId      String                @map("employee_id")
  employee        Employee              @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  devicePublicKey String                @unique @map("device_public_key")
  installationId  String                @unique @map("installation_id")
  platform        String // ANDROID | IOS
  deviceName      String?               @map("device_name")
  appVersion      String?               @map("app_version")
  status          DeviceStatus          @default(PENDING)
  registeredAt    DateTime              @default(now()) @map("registered_at")
  lastSeenAt      DateTime?             @map("last_seen_at")
  revokedAt       DateTime?             @map("revoked_at")
  revokedBy       String?               @map("revoked_by")
  revoker         User?                 @relation("DeviceRevoker", fields: [revokedBy], references: [id], onDelete: SetNull)
  revokeReason    String?               @map("revoke_reason")
  sessions        Session[]
  auditLogs       AuditLog[]
  attendances     Attendance[]
  oldChanges      DeviceChangeRequest[] @relation("OldDevice")
  newChanges      DeviceChangeRequest[] @relation("NewDevice")
  // Catatan: index parsial "devices_one_active_per_employee" sudah DIHAPUS
  // (migrasi 20261021000000_multi_device). Satu karyawan boleh punya beberapa
  // perangkat ACTIVE sekaligus.

  @@index([employeeId])
  @@index([status])
  @@map("devices")
}

model DeviceChangeRequest {
  id          String             @id @default(cuid())
  employeeId  String             @map("employee_id")
  employee    Employee           @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  oldDeviceId String?            @map("old_device_id")
  oldDevice   Device?            @relation("OldDevice", fields: [oldDeviceId], references: [id], onDelete: Restrict)
  newDeviceId String             @map("new_device_id")
  newDevice   Device             @relation("NewDevice", fields: [newDeviceId], references: [id], onDelete: Restrict)
  reason      String
  status      DeviceChangeStatus @default(PENDING)
  requestedAt DateTime           @default(now()) @map("requested_at")
  reviewedBy  String?            @map("reviewed_by")
  reviewer    User?              @relation("ChangeReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)
  reviewedAt  DateTime?          @map("reviewed_at")
  reviewNote  String?            @map("review_note")

  @@index([employeeId])
  @@index([status])
  @@map("device_change_requests")
}

// ---------------- Shift & schedule (PRD §20, night shift aware) ----------------

model Shift {
  id                        String             @id @default(cuid())
  hospitalId                String             @map("hospital_id")
  hospital                  Hospital           @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  name                      String // PAGI | SIANG | MALAM (custom names allowed)
  startTime                 String             @map("start_time") // HH:mm, app-validated
  endTime                   String             @map("end_time") // HH:mm, may be next day
  overnight                 Boolean            @default(false) // true for 23:00 -> 07:00
  gracePeriodMin            Int                @default(15) @map("grace_period_min")
  lateThresholdMin          Int                @default(30) @map("late_threshold_min")
  earlyCheckoutThresholdMin Int                @default(15) @map("early_checkout_threshold_min")
  createdAt                 DateTime           @default(now()) @map("created_at")
  updatedAt                 DateTime           @updatedAt @map("updated_at")
  schedules                 EmployeeSchedule[]
  attendances               Attendance[]

  @@unique([hospitalId, name])
  @@index([hospitalId])
  @@map("shifts")
}

model EmployeeSchedule {
  id          String       @id @default(cuid())
  employeeId  String       @map("employee_id")
  employee    Employee     @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  shiftId     String       @map("shift_id")
  shift       Shift        @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  workDate    DateTime     @map("work_date") @db.Date // shift start date; night shift counts as one
  createdAt   DateTime     @default(now()) @map("created_at")
  attendances Attendance[]

  @@unique([employeeId, workDate])
  @@index([shiftId])
  @@map("employee_schedules")
}

// ---------------- Attendance engine (PRD §21-§24) ----------------

model Attendance {
  id              String              @id @default(cuid())
  employeeId      String              @map("employee_id")
  employee        Employee            @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  shiftId         String              @map("shift_id")
  shift           Shift               @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  scheduleId      String?             @unique @map("schedule_id") // one attendance per roster row
  schedule        EmployeeSchedule?   @relation(fields: [scheduleId], references: [id], onDelete: Restrict)
  workDate        DateTime            @map("work_date") @db.Date
  checkInAt       DateTime?           @map("check_in_at")
  checkOutAt      DateTime?           @map("check_out_at")
  checkInStatus   CheckInStatus?      @map("check_in_status")
  checkOutStatus  CheckOutStatus?     @map("check_out_status")
  captureAt       DateTime?           @map("capture_at")
  syncedAt        DateTime            @default(now()) @map("synced_at")
  offline         Boolean             @default(false)
  staleAt         DateTime?           @map("stale_at")
  riskScore        Int?            @map("risk_score") // 0-100, CHECK in migration SQL
  riskCategory     RiskCategory?   @map("risk_category")
  needsReview      Boolean         @default(false) @map("needs_review") // MEDIUM risk supervisor queue (STEP 13/17)
  deviceId        String?             @map("device_id")
  device          Device?             @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  notes           String?
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")
  corrections     CorrectionRequest[]

  @@index([employeeId, workDate])
  @@index([workDate], map: "attendance_work_date_idx")
  @@index([riskCategory])
  @@map("attendance")
}

// ---------------- Correction & leave (PRD §36-§37) ----------------

model CorrectionRequest {
  id                String         @id @default(cuid())
  employeeId        String         @map("employee_id")
  employee          Employee       @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  attendanceId      String         @map("attendance_id")
  attendance        Attendance     @relation(fields: [attendanceId], references: [id], onDelete: Restrict)
  type              CorrectionType
  requestedCheckIn  DateTime?      @map("requested_check_in")
  requestedCheckOut DateTime?      @map("requested_check_out")
  reason            String
  evidenceUrl       String?        @map("evidence_url")
  status            RequestStatus  @default(PENDING)
  requestedAt       DateTime       @default(now()) @map("requested_at")
  reviewedBy        String?        @map("reviewed_by")
  reviewer          User?          @relation("CorrectionReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)
  reviewedAt        DateTime?      @map("reviewed_at")
  reviewNote        String?        @map("review_note")

  @@index([employeeId])
  @@index([attendanceId])
  @@index([status])
  @@map("correction_requests")
}

model LeaveRequest {
  id          String        @id @default(cuid())
  employeeId  String        @map("employee_id")
  employee    Employee      @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  type        LeaveType
  startDate   DateTime      @map("start_date") @db.Date
  endDate     DateTime      @map("end_date") @db.Date // CHECK end >= start in migration SQL
  reason      String
  status      RequestStatus @default(PENDING)
  requestedAt DateTime      @default(now()) @map("requested_at")
  reviewedBy  String?       @map("reviewed_by")
  reviewer    User?         @relation("LeaveReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)
  reviewedAt  DateTime?     @map("reviewed_at")
  reviewNote  String?       @map("review_note")

  @@index([employeeId])
  @@index([status])
  @@map("leave_requests")
}

// ---------------- Audit & session (PRD §30, §34) ----------------

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?  @map("actor_id")
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action     String // LOGIN_SUCCESS, CHECK_IN, DEVICE_REVOKED, ... (canonical list in docs)
  targetType String?  @map("target_type")
  targetId   String?  @map("target_id")
  timestamp  DateTime @default(now())
  ipAddress  String?  @map("ip_address")
  deviceId   String?  @map("device_id")
  device     Device?  @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  metadata   Json?
  result     String? // SUCCESS | FAILED | DENIED

  @@index([action, timestamp])
  @@index([actorId])
  @@index([targetType, targetId])
  @@index([timestamp(sort: Desc)], map: "audit_logs_timestamp_idx")
  @@map("audit_logs")
}

model Session {
  id               String    @id @default(cuid())
  userId           String    @map("user_id")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId         String?   @map("device_id")
  device           Device?   @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  refreshTokenHash String    @unique @map("refresh_token_hash") // rotation + revocation (STEP 3)
  ipAddress        String?   @map("ip_address")
  userAgent        String?   @map("user_agent")
  createdAt        DateTime  @default(now()) @map("created_at")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// STEP 12 — single-use request IDs (anti replay). Pruned opportunistically.
model IdempotencyKey {
  key          String   @id
  kind         String   @default("request") @map("kind")
  employeeId   String?  @map("employee_id")
  action       String?
  responseJson Json?    @map("response_json")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([kind])
  @@map("idempotency_keys")
}

// STEP 21 — biometric consent per purpose (UU PDP lawful basis tracking).
model Consent {
  id         String    @id @default(cuid())
  employeeId String    @map("employee_id")
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  purpose    String // BIOMETRIC_ATTENDANCE
  version    String // notice version consented to
  grantedAt  DateTime  @default(now()) @map("granted_at")
  revokedAt  DateTime? @map("revoked_at")

  @@unique([employeeId, purpose])
  @@index([employeeId])
  @@map("consents")
}


// ---------------- Handover (operan bangsal jaga) ----------------

model Handover {
  id               String     @id @default(cuid())
  hospitalId       String     @map("hospital_id")
  hospital         Hospital   @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  departmentId     String?    @map("department_id")
  department       Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  fromEmployeeId   String     @map("from_employee_id")
  fromEmployee     Employee   @relation("HandoverFrom", fields: [fromEmployeeId], references: [id], onDelete: Restrict)
  toEmployeeId     String?    @map("to_employee_id")
  toEmployee       Employee?  @relation("HandoverTo", fields: [toEmployeeId], references: [id], onDelete: SetNull)
  title            String
  patientSummary   String?    @map("patient_summary")
  pendingTasks     String?    @map("pending_tasks")
  medications      String?    @map("medications")
  incidents        String?    @map("incidents")
  notes            String?
  status           String     @default("PENDING")
  acknowledgedById  String?    @map("acknowledged_by_id")
  acknowledgedBy   User?      @relation("HandoverAcknowledger", fields: [acknowledgedById], references: [id], onDelete: SetNull)
  acknowledgedAt   DateTime?  @map("acknowledged_at")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  @@index([hospitalId])
  @@index([departmentId])
  @@index([fromEmployeeId])
  @@index([status])
  @@map("handovers")
}
