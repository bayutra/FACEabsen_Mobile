# Origin of the NestJS backend. Only the Next.js server calls it; the browser
# never talks to the API origin directly.
# Local development defaults to http://localhost:3000.
API_ORIGIN=http://localhost:3000

# Shared secret proving a login request comes from this dashboard server.
# Must be identical to DASHBOARD_CLIENT_SECRET on the backend.
DASHBOARD_CLIENT_SECRET=CHANGE-ME-min-32-chars-random
