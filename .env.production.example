# Hospital Face ID Attendance — PRODUCTION env template (STEP 25).
# Copy to .env.production and fill EVERYTHING. Never commit the filled file.
# Used by: docker compose (--env-file), backend, web.

# --- Postgres (least-privilege app account created out-of-band) ---
POSTGRES_DB=face_absen
POSTGRES_USER=face_absen_app
POSTGRES_PASSWORD=CHANGE-ME-strong-random

# --- Redis ---
REDIS_PASSWORD=CHANGE-ME-strong-random
# REDIS_URL dirakit docker-compose dari REDIS_PASSWORD di atas (jangan isi manual).

# --- Backend ---
NODE_ENV=production
PORT=3000
API_PREFIX=api/v1
CORS_ORIGIN=https://absen.rumahsakit.example
# DATABASE_URL dirakit docker-compose dari POSTGRES_* di atas (jangan isi manual).
JWT_ACCESS_SECRET=CHANGE-ME-min-32-chars-random
JWT_ACCESS_TTL_SEC=900
REFRESH_TTL_DAYS=7
LOGIN_MAX_ATTEMPTS=5
LOCKOUT_MINUTES=15
DATA_ENCRYPTION_KEY=CHANGE-ME-base64-32-bytes
GEO_MAX_ACCURACY_M=50
GEO_MAX_SKEW_MIN=5
FACE_MATCH_THRESHOLD=0.5
LIVENESS_MAX_AGE_MIN=10
REQUEST_MAX_SKEW_MIN=5
HOSPITAL_TZ=Asia/Jakarta
RISK_W_FACE=30
RISK_W_LIVENESS=20
RISK_W_DEVICE=15
RISK_W_INTEGRITY=10
RISK_W_GPS=10
RISK_W_GEOFENCE=10
RISK_W_SIGNATURE=5
RISK_LOW_MIN=90
RISK_MEDIUM_MIN=70
RISK_MEDIUM_REVIEW=true
RETENTION_SESSION_DAYS=30
RETENTION_FACE_INACTIVE_DAYS=90

# --- Bootstrap admin (seed prod ONLY, bukan demo) ---
# Diisi SEKALI di host, dipakai scripts/db-go-live.sh. Hapus/kosongkan setelah seed.
BOOTSTRAP_ADMIN_EMAIL=admin@rumahsakit.example
BOOTSTRAP_ADMIN_PASSWORD=CHANGE-ME-min-12-char-random

# --- Play Integrity / App Attest (STEP go-live) ---
# strict=false until the mobile app actually sends integrity tokens AND the
# backend verifies signatures server-to-server (fase-2). strict=true with the
# current client REJECTS EVERY PUNCH (missing token = fail). When fase-2
# lands, flip to true and keep package/bundle pinned below.
INTEGRITY_STRICT=false
# Must equal the Play Console applicationId / App Store bundleId exactly,
# otherwise every token fails WRONG_PACKAGE. Current app IDs:
ANDROID_PACKAGE_NAME=com.hospital.faceid.face_absen_mobile
IOS_BUNDLE_ID=com.hospital.faceid.faceAbsenMobile

# --- Web (server-side; BFF hides the backend) ---
API_URL=http://backend:3000/api/v1
NEXT_PUBLIC_API_URL=https://absen.rumahsakit.example/api/v1
NEXT_PUBLIC_APP_NAME=Face ID Attendance
